# Compression (JSON incluse : les numéros font 50 à 80 Ko non compressés)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Cache : les fichiers statiques longtemps, les données du numéro 5 minutes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
AddType application/json .json

# Les pages HTML ne sont jamais gardees en cache : elles portent le numero de
# version des scripts (?v=N), c'est ce qui permet de livrer un correctif tout de suite.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Le sitemap et robots.txt pour les moteurs de recherche
<IfModule mod_expires.c>
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>
